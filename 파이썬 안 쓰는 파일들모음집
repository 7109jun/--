	parser = argparse.ArgumentParser(prog="NON", description="NON - Local RAG assistant (single-file)")
	sub = parser.add_subparsers(dest="cmd")

	p_ingest = sub.add_parser("ingest")
	p_ingest.add_argument("path")

	p_chat = sub.add_parser("chat")
	p_chat.add_argument("--session", default="new")

	p_brain = sub.add_parser("brainstorm")
	p_brain.add_argument("prompt", nargs=argparse.REMAINDER)

	p_code = sub.add_parser("code")
	p_code.add_argument("prompt", nargs=argparse.REMAINDER)

	args = parser.parse_args(argv)
	if args.cmd == "ingest":
		ingest_path(args.path)
	elif args.cmd == "chat":
		cli_chat(session_id=args.session)
	elif args.cmd == "brainstorm":
