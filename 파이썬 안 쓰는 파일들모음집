"""
Lightweight test to validate AI.py flow without external models.

This test monkeypatches embedding/model loaders to avoid network or heavy deps.
It performs:
- create a small docs folder with one text file
- monkeypatch `ensure_embed_model` to provide deterministic embeddings
- monkeypatch `get_local_model` to provide a simple generator
- run `ingest_path`, `generate_reply` and verify a session file is created
"""
import os
import json
import shutil
from pathlib import Path

ROOT = Path(__file__).parent
DOCS_DIR = ROOT / "test_docs"
SESSIONS_DIR = ROOT / "sessions_cli"

class DummyEmbedModel:
    def encode(self, texts):
        # return a simple numeric embedding: sum of char codes mod 100
        import numpy as _np
        if isinstance(texts, list):
            return [_np.array([sum(map(ord, t)) % 100]) for t in texts]
        return _np.array([sum(map(ord, texts)) % 100])


class DummyLocalModel:
    def __init__(self):
        pass
    def available(self):
        return True
    def generate(self, history, max_new_tokens=128, temperature=0.7):
        # simple reply echoing last user message
        last = ""
        for m in reversed(history):
            if m.get("role") == "user":
                last = m.get("content")
                break
        return f"(dummy reply) I understood: {last}"
    def fallback(self, history):
        return "(dummy fallback)"


def run():
    # prepare docs
    if DOCS_DIR.exists():
        shutil.rmtree(DOCS_DIR)
    DOCS_DIR.mkdir()
    sample = DOCS_DIR / "sample.txt"
    sample.write_text("This is a small document about testing NON assistant.")

    # import target module
    import importlib
    import AI
    import numpy as np

    # monkeypatch embedding loader and model loader
    AI.ensure_embed_model = lambda: DummyEmbedModel()
    AI.np = np
    AI.get_local_model_backup = getattr(AI, "get_local_model", None)
    AI.get_local_model = lambda: DummyLocalModel()

    # run ingest
    AI.ingest_path(str(DOCS_DIR))

    # run generate_reply
    out, sid = AI.generate_reply("Please summarize testing approach.")
    print("Reply:", out)
    print("Session:", sid)

    # verify session file
    session_file = SESSIONS_DIR / f"{sid}.json"
    assert session_file.exists(), "Session file was not created"
    data = json.loads(session_file.read_text(encoding="utf-8"))
    assert any(m.get("role") == "assistant" for m in data), "No assistant message in session"

    print("TEST PASSED")
"""
Local model loader and generator for NON (API-key free operation)

This module tries to load a Hugging Face compatible causal LM from a local
path or model name. If not available, it provides a deterministic fallback.
"""

import os
from typing import List, Optional

try:
    import torch
    from transformers import AutoTokenizer, AutoModelForCausalLM
except Exception:
    torch = None
    AutoTokenizer = None
    AutoModelForCausalLM = None


class LocalModel:
    def __init__(self, model_name_or_path: Optional[str] = None, device: Optional[str] = None):
        self.model = None
        self.tokenizer = None
        self.device = device or ("cuda" if torch and torch.cuda.is_available() else "cpu")
        self.model_name_or_path = model_name_or_path or os.environ.get("LOCAL_MODEL_PATH")
        if self.model_name_or_path and AutoTokenizer and AutoModelForCausalLM and torch:
            try:
                self.tokenizer = AutoTokenizer.from_pretrained(self.model_name_or_path)
                self.model = AutoModelForCausalLM.from_pretrained(self.model_name_or_path)
                self.model.to(self.device)
            except Exception:
                self.model = None

    def available(self) -> bool:
        return self.model is not None and self.tokenizer is not None

    def build_prompt(self, history: List[dict]) -> str:
        # Compose a short prompt from history
        lines = ["You are NON, a helpful coding and brainstorming assistant."]
        for m in history[-10:]:
            role = m.get("role", "user")
            prefix = "User:" if role == "user" else "Assistant:"
            lines.append(f"{prefix} {m.get('content','')}")
        lines.append("Assistant:")
        return "\n".join(lines)

    def generate(self, history: List[dict], max_new_tokens: int = 256, temperature: float = 0.7) -> str:
        if not self.available():
            return self.fallback(history)

        prompt = self.build_prompt(history)
        inputs = self.tokenizer(prompt, return_tensors="pt")
        input_ids = inputs["input_ids"].to(self.device)
        try:
            with torch.no_grad():
                outputs = self.model.generate(
                    input_ids,
                    max_new_tokens=max_new_tokens,
                    do_sample=True,
                    temperature=temperature,
                    top_p=0.9,
                    eos_token_id=self.tokenizer.eos_token_id,
                )
            text = self.tokenizer.decode(outputs[0][input_ids.shape[-1]:], skip_special_tokens=True)
            return text.strip()
        except Exception as e:
            return f"[local model error] {e}"

    def fallback(self, history: List[dict]) -> str:
        last_user = ""
        for m in reversed(history):
            if m.get("role") == "user":
                last_user = m.get("content")
                break
        if not last_user:
            return "안녕하세요. 무엇을 도와드릴까요? (로컬 폴백)"
        return (
            f"(local-fallback) 아이디어:\n- 핵심 요약: {last_user}\n- 작은 실험: 작성한 코드 예제 시도\n- 다음 단계: 입력을 더 구체화하세요"
        )


_GLOBAL_LOCAL_MODEL = None


def get_local_model() -> LocalModel:
    global _GLOBAL_LOCAL_MODEL
    if _GLOBAL_LOCAL_MODEL is None:
        _GLOBAL_LOCAL_MODEL = LocalModel()
    return _GLOBAL_LOCAL_MODEL


if __name__ == "__main__":
    lm = get_local_model()
    print("Local model available:", lm.available())
"""
Simple FastAPI server for NON assistant with in-memory session context and disk persistence.

Endpoints:
- POST /sessions -> creates a new session id
- GET /sessions/{session_id} -> returns conversation history
- POST /sessions/{session_id}/message -> send user message, returns assistant reply

Run:
  uvicorn server:app --reload --port 8000
"""

import os
import json
import uuid
from typing import List
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

try:
    import openai
except Exception:
    openai = None

SESSIONS_DIR = os.path.join(os.path.dirname(__file__), "sessions")
os.makedirs(SESSIONS_DIR, exist_ok=True)

app = FastAPI(title="NON Assistant API")


class MessageIn(BaseModel):
    content: str


def session_path(session_id: str) -> str:
    return os.path.join(SESSIONS_DIR, f"{session_id}.json")


def load_session(session_id: str) -> List[dict]:
    path = session_path(session_id)
    if not os.path.exists(path):
        return []
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_session(session_id: str, messages: List[dict]):
    path = session_path(session_id)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(messages, f, ensure_ascii=False, indent=2)


def openai_reply(messages: List[dict]) -> str:
    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key or openai is None:
        return None
    openai.api_key = api_key
    try:
        resp = openai.ChatCompletion.create(
            model=os.environ.get("OPENAI_MODEL", "gpt-4o-mini"),
            messages=messages,
            max_tokens=700,
            temperature=0.7,
        )
        return resp["choices"][0]["message"]["content"].strip()
    except Exception as e:
        return f"[openai error] {e}"


def fallback_reply(messages: List[dict]) -> str:
    # Simple heuristic fallback: echo last user message with suggestions
    last = ""
    for m in reversed(messages):
        if m.get("role") == "user":
            last = m.get("content")
            break
    if not last:
        return "안녕하세요, 무엇을 도와드릴까요?"
    return f"(fallback) 다음 아이디어를 고려해보세요:\n- 핵심: {last}\n- 작은 실험 설계\n- 필요한 라이브러리/도구 제안"


def build_messages(history: List[dict]) -> List[dict]:
    system = {
        "role": "system",
        "content": (
            "You are NON, a helpful, context-aware coding and brainstorming assistant. "
            "Read the user's previous messages in the session and respond considering prior context."
        ),
    }
    # history already is a list of {'role': 'user'|'assistant', 'content': ...}
    return [system] + history


@app.post("/sessions")
def create_session():
    sid = uuid.uuid4().hex
    save_session(sid, [])
    return {"session_id": sid}


@app.get("/sessions/{session_id}")
def get_session(session_id: str):
    messages = load_session(session_id)
    if messages is None:
        raise HTTPException(status_code=404, detail="Session not found")
    return {"session_id": session_id, "messages": messages}


@app.post("/sessions/{session_id}/message")
def post_message(session_id: str, body: MessageIn):
    messages = load_session(session_id)
    if messages is None:
        raise HTTPException(status_code=404, detail="Session not found")

    # append user message
    messages.append({"role": "user", "content": body.content})

    # prepare messages with system prompt and history
    ai_messages = build_messages(messages)

    # call OpenAI or fallback
    reply = openai_reply(ai_messages)
    if reply is None:
        reply = fallback_reply(messages)

    messages.append({"role": "assistant", "content": reply})
    save_session(session_id, messages)
    return {"response": reply, "session_id": session_id}


if __name__ == "__main__":
    print("Run with: uvicorn server:app --reload --port 8000")
# NON — Minimal brainstorming & coding assistant

간단한 로컬/원격 하이브리드 AI 도우미 `NON`입니다. Python 스크립트로 실행할 수 있으며, `OPENAI_API_KEY`가 설정되어 있고 `openai` 패키지가 설치되어 있으면 OpenAI API를 사용합니다. 그렇지 않으면 간단한 로컬 폴백 동작을 제공합니다.

사용법:

```bash
python AI.py brainstorm "새로운 라이브러리 아이디어"
python AI.py code "데이터를 정렬하는 함수 작성"
```

환경변수:
- `OPENAI_API_KEY` (선택) : OpenAI API 키가 있으면 설정하세요.
- `OPENAI_MODEL` (선택) : 호출할 모델 이름, 기본값은 `gpt-4o-mini`.

설치:

```bash
pip install -r requirements.txt
```

다음 단계 제안:
- 간단한 HTTP API로 감싸기 (Flask/FastAPI)
- VS Code 확장으로 에디터 통합
- 대화 기록, 컨텍스트 창(파일 내용) 전달

서버 실행 (FastAPI):

```bash
uvicorn server:app --reload --port 8000
```

API 사용 예시 (새 세션 생성 후 메시지 전송):

```bash
# 새 세션 생성
curl -X POST http://127.0.0.1:8000/sessions

# 메시지 보내기 (세션 아이디를 위 응답에서 가져와서 사용)
curl -X POST -H "Content-Type: application/json" -d '{"content":"안녕, 아이디어 내줘"}' http://127.0.0.1:8000/sessions/<session_id>/message

로컬 모델 사용 (API 키 불필요):

- 로컬에서 Hugging Face 호환 모델을 사용하려면 모델을 다운로드하거나 경로를 `LOCAL_MODEL_PATH` 환경변수로 지정하세요.
- GPU가 있으면 `LOCAL_MODEL_PATH`에 큰 모델을 놓고 더 나은 성능을 얻을 수 있습니다. CPU로도 작동하지만 느립니다.

예시:

```bash
# 모델을 로컬로 다운로드한 뒤 경로를 설정
export LOCAL_MODEL_PATH=/path/to/model
python -c "from local_model import get_local_model; print(get_local_model().available())"

# 서버를 실행하면 로컬 모델을 우선 사용합니다
uvicorn server:app --reload --port 8000
```

권장 모델:
- 소규모/테스트: `gpt2` (빠름, 품질 낮음)
- 중간급: `EleutherAI/gpt-j-6B` (품질 좋음, 큰 메모리 필요)
- 최신/고성능: Llama 계열 또는 다른 대형 모델(설치와 라이센스 확인 필요)

참고: 로컬 모델 사용은 디스크/메모리와 시간 비용이 크며, 필요한 경우 모델 다운로드와 환경 설정을 제가 도와드릴 수 있습니다.
