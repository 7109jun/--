import os
import sys
import json
import uuid
import argparse
import textwrap
from pathlib import Path
from typing import List, Dict

ROOT = Path(__file__).parent
SESSIONS_DIR = ROOT / "sessions_cli"
STORE_PATH = ROOT / "embeddings_store.json"
os.makedirs(SESSIONS_DIR, exist_ok=True)

try:
	from sentence_transformers import SentenceTransformer
	import numpy as np
except Exception:
	SentenceTransformer = None
	np = None

try:
	from local_model import get_local_model
except Exception:
	get_local_model = None


def load_store():
	if not STORE_PATH.exists():
		return []
	with open(STORE_PATH, "r", encoding="utf-8") as f:
		return json.load(f)


def save_store(items):
	with open(STORE_PATH, "w", encoding="utf-8") as f:
		json.dump(items, f, ensure_ascii=False, indent=2)


def chunk_text(text: str, chunk_size: int = 800) -> List[str]:
	text = text.replace("\r\n", "\n")
	chunks = []
	i = 0
	while i < len(text):
		chunk = text[i:i+chunk_size]
		chunks.append(chunk)
		i += chunk_size
	return chunks


def ensure_embed_model():
	if SentenceTransformer is None:
		print("[error] sentence-transformers not installed. See requirements.txt")
		sys.exit(1)
	return SentenceTransformer("all-MiniLM-L6-v2")


def ingest_path(path: str):
	model = ensure_embed_model()
	store = load_store()
	path = Path(path)
	files = []
	if path.is_file():
		files = [path]
	else:
		for ext in ("*.md", "*.txt", "*.py", "*.rst"):
			files.extend(path.rglob(ext))

	new = 0
	for f in files:
		text = f.read_text(encoding="utf-8")
		for chunk in chunk_text(text):
			emb = model.encode(chunk).tolist()
			store.append({"id": uuid.uuid4().hex, "text": chunk, "source": str(f), "embedding": emb})
			new += 1
	save_store(store)
	print(f"Ingested {new} chunks from {len(files)} files. Store size: {len(store)}")


def embed_query(query: str):
	model = ensure_embed_model()
	return model.encode(query)


def search(query: str, k: int = 3):
	items = load_store()
	if not items:
		return []
	if np is None:
		print("[warning] numpy not available, returning first items")
		return items[:k]
	qv = embed_query(query)
	embs = np.array([it["embedding"] for it in items])
	qv = np.array(qv)
	# cosine similarity
	embs_norm = embs / np.linalg.norm(embs, axis=1, keepdims=True)
	qn = qv / np.linalg.norm(qv)
	sims = embs_norm.dot(qn)
	idx = np.argsort(-sims)[:k]
	return [items[int(i)] for i in idx]


def create_session_id():
	sid = uuid.uuid4().hex
	path = SESSIONS_DIR / f"{sid}.json"
	path.write_text(json.dumps([]), encoding="utf-8")
	return sid


def load_session(sid: str):
	path = SESSIONS_DIR / f"{sid}.json"
	if not path.exists():
		return None
	return json.loads(path.read_text(encoding="utf-8"))


def save_session(sid: str, messages: List[Dict]):
	path = SESSIONS_DIR / f"{sid}.json"
	path.write_text(json.dumps(messages, ensure_ascii=False, indent=2), encoding="utf-8")


def build_rag_prompt(query: str, retrieved: List[Dict], history: List[Dict]) -> str:
	system = "You are NON, a context-aware coding and brainstorming assistant. Use retrieved documents when helpful."
	parts = [system, "\n=== Retrieved Documents ===\n"]
	for r in retrieved:
		parts.append(f"Source: {r.get('source','unknown')}\n{r.get('text')}\n---\n")
	parts.append("\n=== Conversation ===\n")
	for m in history[-10:]:
		role = m.get("role")
		parts.append(f"{role}: {m.get('content')}\n")
	parts.append(f"user: {query}\nassistant:")
	return "\n".join(parts)


def generate_reply(query: str, session_id: str = None, top_k: int = 3):
	history = []
	if session_id:
		s = load_session(session_id)
		if s is not None:
			history = s
	retrieved = search(query, k=top_k)
	prompt = build_rag_prompt(query, retrieved, history)

	# try local model
	if get_local_model is not None:
		lm = get_local_model()
		if lm.available():
			# convert history+doc context into lm history format
			lm_history = []
			lm_history.append({"role": "system", "content": "You are NON, a helpful assistant."})
			for r in retrieved:
				lm_history.append({"role": "system", "content": f"Retrieved: {r.get('text')}"})
			for m in history:
				lm_history.append(m)
			lm_history.append({"role": "user", "content": query})
			text = lm.generate(lm_history, max_new_tokens=256)
		else:
			text = lm.fallback(history)
	else:
		text = "(no local model available) " + "\n\n".join([r.get('text') for r in retrieved])

	# save to session
	if session_id is None:
		session_id = create_session_id()
	messages = load_session(session_id) or []
	messages.append({"role": "user", "content": query})
	messages.append({"role": "assistant", "content": text})
	save_session(session_id, messages)
	return text, session_id


def cli_chat(session_id: str = None):
	if session_id == "new" or session_id is None:
		session_id = create_session_id()
		print(f"Created session: {session_id}")
	else:
		print(f"Using session: {session_id}")
	while True:
		try:
			q = input("You: ")
		except (EOFError, KeyboardInterrupt):
			print("\nExiting chat")
			break
		if not q.strip():
			continue
		out, sid = generate_reply(q, session_id=session_id)
		print("NON:", out)


def brainstorm_local(prompt: str):
	# Use retrieval to augment brainstorming
	retrieved = search(prompt, k=4)
	summary = "\n\n".join([r.get('text') for r in retrieved])
	text, sid = generate_reply(prompt)
	return text


def code_local(prompt: str):
	# simple code scaffold using LM or fallback
	if get_local_model is not None:
		lm = get_local_model()
		if lm.available():
			return lm.generate([{"role":"user","content":prompt}], max_new_tokens=300)
		else:
			return lm.fallback([])
	return "[no local model available]"


