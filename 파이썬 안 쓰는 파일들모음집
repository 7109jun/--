"""
setup_model.py

Download a Hugging Face model repository to a local folder and print instructions
for setting `LOCAL_MODEL_PATH` so `NON` (AI.py) can load it.

Usage:
  python setup_model.py --model gpt2 --target ./models/gpt2
  python setup_model.py --model EleutherAI/gpt-j-6B --target ./models/gpt-j-6B

Notes:
- This script uses `huggingface_hub.snapshot_download` to fetch model files without
  instantiating the full model in memory.
"""

import argparse
from pathlib import Path
import sys

try:
    from huggingface_hub import snapshot_download
except Exception:
    snapshot_download = None


def download_model(repo_id: str, target: Path) -> Path:
    if snapshot_download is None:
        print("[error] huggingface_hub not installed. Please pip install -r requirements.txt")
        sys.exit(1)

    target.parent.mkdir(parents=True, exist_ok=True)
    print(f"Downloading {repo_id} into cache under: {target.parent}")
    try:
        out = snapshot_download(repo_id=repo_id, cache_dir=str(target.parent))
        out_path = Path(out)
        # snapshot_download places files in cache_dir/<repo_id_hash>/; copy or link is optional
        # To keep it simple, if out_path is a directory, return it; otherwise return target
        print(f"Downloaded to: {out}")
        return out_path
    except Exception as e:
        print(f"[error] failed to download: {e}")
        sys.exit(1)


def print_env_instructions(path: Path):
    print("\nSet LOCAL_MODEL_PATH to the downloaded model folder so NON can load it.")
    print("Unix / macOS:")
    print(f"  export LOCAL_MODEL_PATH=\"{str(path)}\"")
    print("Windows (PowerShell):")
    print(f"  $env:LOCAL_MODEL_PATH=\"{str(path)}\"")
    print("Windows (cmd):")
    print(f"  setx LOCAL_MODEL_PATH \"{str(path)}\"")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--model", required=True, help="Hugging Face repo id (e.g. gpt2 or EleutherAI/gpt-j-6B)")
    parser.add_argument("--target", default="./models", help="Target base folder to store the model")
    args = parser.parse_args()

    target_base = Path(args.target).expanduser().resolve()
    try:
        out_path = download_model(args.model, target_base)
    except SystemExit:
        raise
    except Exception as e:
        print(f"[error] {e}")
        sys.exit(1)

    print_env_instructions(out_path)


if __name__ == "__main__":
    main()
